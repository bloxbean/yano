; ADR-025.2 final authenticated-map v1 governed authorization contract.
; Every value uses preferred definite-length CBOR. Set-like arrays must arrive
; in the stated order; decoding followed by canonical re-encoding must be exact.

digest32 = bytes .size 32
signature64 = bytes .size 64
identifier = tstr .size (1..63)
chain-id = tstr .size (1..128)
authorization-kind = 0 / 1 / 2 / 3 / 4
; open / owner / member / governed-role / approval

mutation = [
  operation: 0 / 1 / 2 / 3 / 4 / 5,
  collection-id: tstr .size (1..64),
  application-key: bytes .size (1..128),
  value: bytes .size (0..1048576),
  expected-revision: uint,
  expected-logical-value-hash: bytes .size (0 / 32),
  new-controller: bytes .size (0 / 32)
]

authorization-assignment = [
  mutation-index: 0..127,
  authorization-kind: authorization-kind,
  policy-id-or-empty: tstr .size (0..63),
  evidence-handle-or-zero: 0..32
]

map-action = [
  version: 1,
  command-kind: 0 / 1, ; single / batch
  mutations: [1*128 mutation],
  authorizations: [1*128 authorization-assignment]
]

actor-authorization-statement = [
  version: 1,
  authorization-id: digest32,
  chain-id: chain-id,
  authenticated-map-genesis-id: digest32,
  action-commitment: digest32,
  covered-mutation-indexes: [1*128 uint], ; strictly ascending
  policy-id: identifier,
  policy-revision: uint .gt 0,
  actor-id: identifier,
  actor-revision: uint .gt 0,
  key-id: identifier,
  claimed-public-key: digest32,
  issued-height: uint .gt 0,
  deadline-height: uint .gt 0,
  signature-algorithm: 0 ; Ed25519
]

actor-authorization = [
  version: 1,
  statement: bytes,
  signature: signature64
]

approval-reference = [
  version: 1,
  proposal-id: identifier,
  action-commitment: digest32,
  covered-mutation-indexes: [1*128 uint], ; strictly ascending
  policy-id: identifier,
  policy-revision: uint .gt 0
]

authorization-evidence = [
  kind: 0 / 1, ; actor authorization / approval reference
  encoded-evidence: bytes
]

authenticated-map-command = [
  version: 1,
  encoded-action: bytes,
  evidence: [*32 authorization-evidence]
]

direct-consumption = [
  version: 1,
  actor-id: identifier,
  authorization-id: digest32,
  action-commitment: digest32,
  applied-height: uint .gt 0,
  message-id: digest32,
  mutation-indexes: [1*128 uint],
  policy-id: identifier,
  policy-revision: uint .gt 0,
  actor-revision: uint .gt 0,
  organization-id: identifier,
  organization-revision: uint .gt 0,
  accepted-role: identifier,
  key-id: identifier,
  statement-digest: digest32,
  signature-digest: digest32
]

approval-consumption = [
  version: 1,
  proposal-id: identifier,
  action-commitment: digest32,
  applied-height: uint .gt 0,
  message-id: digest32,
  mutation-indexes: [1*128 uint],
  policy-id: identifier,
  policy-revision: uint .gt 0
]

; Hash/preimage domains:
; action = Blake2b-256("yano:authenticated-map:action:v1\0" || map-action)
; actor signature = Ed25519(
;   "yano:authenticated-map:actor-authorization:v1\0" || u32be(len) || statement)
;
; Logical state-key application namespaces before composite physical wrapping:
; direct consumption = version:u8 || actor-len:u16be || actor || authorization-id
; approval consumption = proposal-id ASCII, with no collection/action-scope suffix

{
  "schemaVersion": 1,
  "id": "com.bloxbean.cardano.yano.appchain.cardano-history",
  "version": "${pluginVersion}",
  "yanoApi": { "min": 3, "max": 3, "minLevel": 4 },
  "dependencies": [
    {
      "id": "com.bloxbean.cardano.yano.appchain.stdlib",
      "minVersion": "${pluginVersion}",
      "maxVersionExclusive": "0.2.0"
    }
  ],
  "contributions": [
    {
      "kind": "app-state-machine",
      "name": "cardano-history",
      "provider": "com.bloxbean.cardano.yano.appchain.history.CardanoHistoryStateMachineProvider"
    },
    {
      "kind": "domain-api",
      "name": "com.bloxbean.cardano.yano.appchain.cardano-history",
      "provider": "com.bloxbean.cardano.yano.appchain.history.CardanoHistoryDomainApiProvider"
    }
  ]
}

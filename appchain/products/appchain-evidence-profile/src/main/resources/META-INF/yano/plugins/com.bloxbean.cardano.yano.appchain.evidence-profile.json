{
  "schemaVersion": 1,
  "id": "com.bloxbean.cardano.yano.appchain.evidence-profile",
  "version": "${pluginVersion}",
  "yanoApi": { "min": 3, "max": 3, "minLevel": 4 },
  "dependencies": [
    {
      "id": "com.bloxbean.cardano.yano.appchain.stdlib",
      "minVersion": "${pluginVersion}",
      "maxVersionExclusive": "0.2.0"
    },
    {
      "id": "com.bloxbean.cardano.yano.appchain.evidence-registry",
      "minVersion": "${pluginVersion}",
      "maxVersionExclusive": "0.2.0"
    },
    {
      "id": "com.bloxbean.cardano.yano.appchain.role-workflow",
      "minVersion": "${pluginVersion}",
      "maxVersionExclusive": "0.2.0"
    }
  ],
  "contributions": [
    {
      "kind": "app-state-machine",
      "name": "composite",
      "provider": "com.bloxbean.cardano.yano.appchain.evidence.profile.EvidenceCompositeStateMachineProvider"
    },
    {
      "kind": "app-state-machine",
      "name": "role-evidence",
      "provider": "com.bloxbean.cardano.yano.appchain.evidence.profile.RoleEvidenceStateMachineProvider"
    },
    {
      "kind": "domain-api",
      "name": "com.bloxbean.cardano.yano.appchain.evidence-profile",
      "provider": "com.bloxbean.cardano.yano.appchain.evidence.profile.RoleEvidenceDomainApiProvider"
    }
  ]
}

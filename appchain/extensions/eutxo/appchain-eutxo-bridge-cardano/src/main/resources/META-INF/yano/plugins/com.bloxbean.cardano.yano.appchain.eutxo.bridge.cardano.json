{
  "schemaVersion": 1,
  "id": "com.bloxbean.cardano.yano.appchain.eutxo.bridge.cardano",
  "version": "${pluginVersion}",
  "yanoApi": { "min": 3, "max": 3, "minLevel": 4 },
  "dependencies": [
    {
      "id": "com.bloxbean.cardano.yano.appchain.eutxo",
      "minVersion": "${pluginVersion}",
      "maxVersionExclusive": "0.2.0"
    }
  ],
  "contributions": [
    {
      "kind": "l1-observer",
      "name": "eutxo-vault-deposit-v1",
      "provider": "com.bloxbean.cardano.yano.appchain.eutxo.bridge.cardano.CardanoBridgeObserverProvider"
    },
    {
      "kind": "l1-observer",
      "name": "eutxo-withdrawal-confirmation-v1",
      "provider": "com.bloxbean.cardano.yano.appchain.eutxo.bridge.cardano.CardanoWithdrawalConfirmationObserverProvider"
    },
    {
      "kind": "l1-observer",
      "name": "eutxo-batch-withdrawal-confirmation-v1",
      "provider": "com.bloxbean.cardano.yano.appchain.eutxo.bridge.cardano.CardanoBatchWithdrawalConfirmationObserverProvider"
    },
    {
      "kind": "effect-executor",
      "name": "eutxo-settlement",
      "provider": "com.bloxbean.cardano.yano.appchain.eutxo.bridge.cardano.EutxoSettlementExecutorFactory"
    }
  ]
}

{
  "schemaVersion": 1,
  "id": "com.bloxbean.cardano.yano.appchain.eutxo.indexer",
  "version": "${pluginVersion}",
  "yanoApi": { "min": 3, "max": 3, "minLevel": 4 },
  "dependencies": [],
  "contributions": [
    {
      "kind": "domain-api",
      "name": "com.bloxbean.cardano.yano.appchain.eutxo.indexer",
      "provider": "com.bloxbean.cardano.yano.appchain.eutxo.indexer.jdbc.EutxoJdbcIndexDomainApiProvider"
    },
    {
      "kind": "local-read-model",
      "name": "com.bloxbean.cardano.yano.appchain.eutxo.indexer",
      "provider": "com.bloxbean.cardano.yano.appchain.eutxo.indexer.jdbc.EutxoLifecycleIndexerProvider"
    },
    {
      "kind": "health",
      "name": "com.bloxbean.cardano.yano.appchain.eutxo.indexer",
      "provider": "com.bloxbean.cardano.yano.appchain.eutxo.indexer.jdbc.EutxoIndexerHealthProvider"
    },
    {
      "kind": "metrics",
      "name": "com.bloxbean.cardano.yano.appchain.eutxo.indexer",
      "provider": "com.bloxbean.cardano.yano.appchain.eutxo.indexer.jdbc.EutxoIndexerMetricsProvider"
    }
  ]
}

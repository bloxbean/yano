{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yano.dev/schema/eutxo-zk-network-acceptance-v1.json",
  "title": "Yano EUTxO ZeroJ network acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewedOn",
    "recipe",
    "authorizationProfile",
    "batchProfile",
    "trustedProverRequired",
    "fundsPolicy",
    "networks",
    "securityGates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "eutxo-zk-network-acceptance/v1"
    },
    "reviewedOn": {
      "type": "string",
      "format": "date"
    },
    "recipe": {
      "const": "eutxo-zeroj-preview:1"
    },
    "authorizationProfile": {
      "const": "zeroj-jubjub-dev-v1"
    },
    "batchProfile": {
      "const": "cardano-payment-b16"
    },
    "trustedProverRequired": {
      "const": true
    },
    "fundsPolicy": {
      "const": "disposable-test-funds-only"
    },
    "networks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devnet", "preview", "preprod", "mainnet"],
      "properties": {
        "devnet": {"$ref": "#/$defs/network"},
        "preview": {"$ref": "#/$defs/network"},
        "preprod": {"$ref": "#/$defs/network"},
        "mainnet": {"$ref": "#/$defs/network"}
      }
    },
    "securityGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maliciousProverSecurity",
        "jubjubAdversarialHardening",
        "productionCeremony",
        "independentAudit"
      ],
      "properties": {
        "maliciousProverSecurity": {"$ref": "#/$defs/gate"},
        "jubjubAdversarialHardening": {"$ref": "#/$defs/gate"},
        "productionCeremony": {"$ref": "#/$defs/gate"},
        "independentAudit": {"$ref": "#/$defs/gate"}
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["PASSED", "NOT_EXERCISED", "BLOCKED_BY_PROFILE", "REJECTED"]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "packagedLifecycle",
        "liveDepositToWithdrawal",
        "rollbackAndRecovery",
        "independentReconstruction"
      ],
      "properties": {
        "policy": {
          "enum": ["ALLOWED", "ACKNOWLEDGEMENT_REQUIRED", "REJECTED"]
        },
        "packagedLifecycle": {"$ref": "#/$defs/gate"},
        "liveDepositToWithdrawal": {"$ref": "#/$defs/gate"},
        "rollbackAndRecovery": {"$ref": "#/$defs/gate"},
        "independentReconstruction": {"$ref": "#/$defs/gate"}
      }
    }
  }
}

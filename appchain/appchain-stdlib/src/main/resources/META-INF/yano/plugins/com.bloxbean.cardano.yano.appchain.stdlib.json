{
  "schemaVersion": 1,
  "id": "com.bloxbean.cardano.yano.appchain.stdlib",
  "version": "${pluginVersion}",
  "yanoApi": { "min": 3, "max": 3, "minLevel": 4 },
  "dependencies": [
    {
      "id": "com.bloxbean.cardano.yano.appchain.role-workflow",
      "minVersion": "${pluginVersion}",
      "maxVersionExclusive": "0.2.0"
    }
  ],
  "contributions": [
    { "kind": "app-state-machine", "name": "authenticated-map", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.StdlibStateMachineProviders$AuthenticatedMapProvider" },
    { "kind": "app-state-machine", "name": "approvals", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.StdlibStateMachineProviders$ApprovalsProvider" },
    { "kind": "app-state-machine", "name": "balances", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.StdlibStateMachineProviders$BalancesProvider" },
    { "kind": "app-state-machine", "name": "doc-trail", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.StdlibStateMachineProviders$DocTrailProvider" },
    { "kind": "app-state-machine", "name": "epoch-params", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.StdlibStateMachineProviders$EpochParamsProvider" },
    { "kind": "app-state-machine", "name": "epoch-governance", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.StdlibStateMachineProviders$EpochGovernanceProvider" },
    { "kind": "app-state-machine", "name": "epoch-stake", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.StdlibStateMachineProviders$EpochStakeProvider" },
    { "kind": "app-state-machine", "name": "kv-registry", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.StdlibStateMachineProviders$KvRegistryProvider" },
    { "kind": "l1-epoch-observer", "name": "l1-epoch-params-v1", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.EpochParamsObserverProvider" },
    { "kind": "l1-epoch-observer", "name": "l1-epoch-governance-v1", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.EpochGovernanceObserverProvider" },
    { "kind": "l1-epoch-observer", "name": "l1-epoch-stake-v1", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.EpochStakeObserverProvider" },
    { "kind": "domain-api", "name": "com.bloxbean.cardano.yano.appchain.stdlib", "provider": "com.bloxbean.cardano.yano.appchain.stdlib.AuthenticatedMapDomainApiProvider" }
  ]
}

; ADR-019 role workflow v1. Arrays use preferred definite CBOR only.
; Set-like arrays MUST arrive in the canonical orders stated below. A decoder
; MUST reject unsorted input rather than silently normalizing it.

identifier = tstr .size (1..63)
role = identifier
chain-id = tstr .size (1..128)
digest32 = bytes .size 32
signature64 = bytes .size 64
status = 0 / 1 / 2 ; ACTIVE / SUSPENDED / REVOKED

organization-record = [
  version: 1,
  organization-id: identifier,
  revision: uint .gt 0,
  status: status,
  metadata-commitment: bytes .size (0 / 32)
]

actor-key-epoch = [
  key-id: identifier,
  public-key: bytes .size 32,
  valid-from-height: uint .gt 0,
  valid-until-height: uint,
  status: status
]

actor-record = [
  version: 1,
  actor-id: identifier,
  organization-id: identifier,
  revision: uint .gt 0,
  status: status,
  roles: [1*16 role], ; ascending UTF-8 role text
  keys: [1*16 actor-key-epoch], ; ascending key-id text
  metadata-commitment: bytes .size (0 / 32)
]

key-proof = [
  version: 1,
  chain-id: chain-id,
  actor-id: identifier,
  actor-revision: uint .gt 0,
  key: actor-key-epoch,
  signature: signature64
]

registry-mutation = [
  version: 1,
  operation: 0 / 1 / 2, ; organization / actor / administrator authority
  record: bytes,
  proofs: [*16 bytes] ; ascending decoded key.key-id text
]

required-clause = [
  clause-id: identifier,
  role: role,
  minimum-count: 1..64,
  distinct-by: 0 / 1 ; actor / organization
]

approval-policy = [
  version: 1,
  policy-id: identifier,
  revision: uint .gt 0,
  status: status,
  proposer-roles: [*16 role], ; ascending UTF-8 role text
  clauses: [1*16 required-clause], ; ascending clause-id text
  rejection-mode: 0 / 1, ; disabled / any eligible
  maximum-lifetime-blocks: 1..1000000
]

direct-role-policy = [
  version: 1,
  policy-id: identifier,
  revision: uint .gt 0,
  status: status,
  required-role: role,
  maximum-authorization-lifetime-blocks: 1..1000000
]

administrator-authority = [
  version: 1,
  authority-id: identifier,
  revision: uint .gt 0,
  administrator-actor-ids: [1*64 identifier], ; ascending actor id
  distinct-actor-threshold: 1..64,
  maximum-mutation-lifetime-blocks: 1..1000000
]

governed-authorization-limits = [
  version: 1,
  maximum-evidence-items-per-command: 1..32,
  maximum-covered-indexes-per-evidence: 1..128,
  maximum-genesis-organizations: 1..64,
  maximum-genesis-actors: 1..128,
  maximum-genesis-keys: 1..256,
  maximum-genesis-policies: 1..128,
  maximum-genesis-record-bytes: 1..262144,
  maximum-pending-governance: 1..1024,
  maximum-pending-approvals: 1..4096,
  maximum-pending-per-actor: 1..64,
  maximum-pending-per-policy: 1..256,
  maximum-pending-per-authority: 1..256,
  maximum-pending-per-deadline: 1..128,
  maximum-expiry-work-per-block: 1..256,
  maximum-authority-supersession-work: 1..256,
  maximum-query-page-size: 1..100,
  maximum-crypto-work-units-per-block: 1..512
]

genesis-actor = [
  version: 1,
  actor-record: bytes,
  key-proofs: [1*16 bytes] ; one per actor key, ascending key id
]

governed-genesis = [
  version: 1,
  chain-id: chain-id,
  administrator-authority: bytes,
  organizations: [1*64 bytes], ; ascending organization id
  actors: [1*128 bytes], ; ascending actor id
  direct-policies: [*128 bytes], ; ascending policy id
  approval-policies: [*128 bytes], ; ascending policy id, disjoint from direct
  limits: bytes
]

policy-mutation = [
  version: 1,
  operation: 0 / 1 / 2, ; put approval policy / cancel proposal / put direct policy
  payload: bytes
]

governed-command = [
  version: 1,
  operation: 0 / 1 / 2 / 3, ; propose / approve / activate / cancel
  mutation-id: identifier,
  mutation-or-hash: bytes,
  expiry-height-or-zero: uint
]

actor-statement = [
  version: 1,
  action: 0 / 1 / 2 / 3, ; propose / approve / reject / cancel
  chain-id: chain-id,
  proposal-id: identifier,
  policy-id: identifier,
  policy-revision: uint .gt 0,
  payload-domain: tstr .size (1..64),
  payload-hash: digest32,
  deadline-height: uint .gt 0,
  actor-id: identifier,
  actor-revision: uint .gt 0,
  key-id: identifier,
  clause-id-or-empty: tstr .size (0..63)
]

administrator-statement = [
  version: 1,
  decision: 0 / 1 / 2, ; propose / approve / cancel
  chain-id: chain-id,
  authenticated-map-genesis-id: digest32,
  authority-id: identifier,
  authority-revision: uint .gt 0,
  mutation-id: identifier,
  mutation-hash: digest32,
  not-before-height: uint .gt 0,
  expiry-height: uint .gt 0,
  actor-id: identifier,
  actor-revision: uint .gt 0,
  key-id: identifier,
  claimed-public-key: digest32,
  issued-height: uint .gt 0,
  deadline-height: uint .gt 0,
  signature-algorithm: 0 ; Ed25519
]

signed-administrator-statement = [
  version: 1,
  statement: bytes,
  signature: signature64
]

actor-governance-command = [
  version: 1,
  operation: 0 / 1 / 2 / 3, ; propose / approve / activate / cancel
  mutation-id: identifier,
  mutation-or-empty: bytes,
  authorizations: [*64 bytes] ; ascending actor id; empty only for activate
]

accepted-administrator-vote = [
  version: 1,
  authorization: bytes, ; signed-administrator-statement
  organization-id: identifier,
  organization-revision: uint .gt 0,
  accepted-height: uint .gt 0
]

governed-mutation-status = 0 / 1 / 2 / 3 / 4 / 5
; PENDING / ACTIVATED / CANCELLED / EXPIRED / FAILED / SUPERSEDED

governed-mutation-record = [
  version: 1,
  mutation-id: identifier,
  mutation: bytes,
  mutation-hash: digest32,
  authority-id: identifier,
  authority-revision: uint .gt 0,
  authority-digest: digest32,
  not-before-height: uint .gt 0,
  expiry-height: uint .gt 0,
  proposer-actor-id: identifier,
  created-height: uint .gt 0,
  accepted-votes: [1*64 bytes], ; accepted-administrator-vote by actor id
  terminal-authorizations: [*64 bytes], ; cancellation votes by actor id
  status: governed-mutation-status,
  terminal-height-or-zero: uint
]

governance-pending-entry = [
  mutation-id: identifier,
  expiry-height: uint .gt 0,
  authority-id: identifier,
  authority-revision: uint .gt 0,
  proposer-actor-id: identifier
]

governance-pending-index = [
  version: 1,
  entries: [*1024 governance-pending-entry] ; ascending mutation id
]

signed-actor-command = [
  version: 1,
  statement: bytes,
  signature: signature64
]

proposal-status = 0 / 1 / 2 / 3 / 4
; PENDING / APPROVED / REJECTED / CANCELLED / EXPIRED

accepted-decision = [
  action: 1 / 2, ; approve / reject
  actor-id: identifier,
  organization-id: identifier,
  organization-revision: uint .gt 0,
  role: role,
  actor-revision: uint .gt 0,
  key-id: identifier,
  clause-id: identifier,
  statement-digest: digest32,
  signature: signature64,
  accepted-height: uint .gt 0
]

approval-proposal = [
  version: 1,
  proposal-id: identifier,
  policy-id: identifier,
  policy-revision: uint .gt 0,
  policy-digest: digest32,
  payload-domain: tstr .size (1..64),
  payload-hash: digest32,
  deadline-height: uint .gt 0,
  status: proposal-status,
  proposer-actor-id: identifier,
  proposer-organization-id: identifier,
  proposer-organization-revision: uint .gt 0,
  proposer-role: role,
  proposer-actor-revision: uint .gt 0,
  proposer-key-id: identifier,
  created-height: uint .gt 0,
  decisions: [*64 accepted-decision] ; ascending (accepted-height, actor-id)
]

approval-stats = [
  version: 1,
  created: uint,
  pending: uint,
  approved: uint,
  rejected: uint,
  cancelled: uint,
  expired: uint
]
; created MUST equal pending + approved + rejected + cancelled + expired.

; Authenticated keys are raw US-ASCII bytes, not CBOR. Exact layouts:
; o/{id}/current, o/{id}/r/{revision}
; a/{id}/current, a/{id}/r/{revision}
; p/{id}/current, p/{id}/r/{revision}
; d/{id}/current, d/{id}/r/{revision}
; h/{id}/current, h/{id}/r/{revision}
; q/{proposal-id}
; s/proposals/v1
; g/{governed-mutation-id}
; x/g/{16-hex-height}/{mutation-id}, x/q/{16-hex-height}/{proposal-id}
; i/g/a/{actor-id}/{mutation-id}, i/g/h/{authority-id}/{mutation-id}
; i/q/a/{actor-id}/{proposal-id}, i/q/p/{policy-id}/{proposal-id}
; A */current value is exactly one positive uint64 revision in big-endian
; binary form. It is not CBOR.

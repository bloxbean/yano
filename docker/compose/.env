YANO_IMAGE_TAG=latest
INSTANCE_NAME=default

YANO_IMAGE=bloxbean/yano
YANO_IMAGE_FLAVOR=jvm

# Comma-separated Quarkus profile list. The launcher uses the first profile as the network.
YANO_PROFILE=preprod
YANO_HTTP_PORT=7070
YANO_N2N_PORT=13337
YANO_UID=1000
YANO_GID=1000
# Host data paths default to data-<network>/{chainstate,runtime-data,appchain-chainstate,appchain-indexers}.
# Optional host path for chainstate. Leave unset for network-specific defaults.
# YANO_CHAINSTATE_PATH=../data-preprod/chainstate
# Persistent parent for snapshots, epoch checkpoints, and the upstream peer store.
# The chainstate directory is mounted inside it; existing databases stay in place.
# YANO_RUNTIME_DATA_PATH=../data-preprod/runtime-data
# Optional host path for authoritative app-chain state. Leave unset for network-specific defaults.
# YANO_APPCHAIN_STATE_PATH=../data-preprod/appchain-chainstate
# Optional host path for rebuildable app-chain indexes. Leave unset for network-specific defaults.
# YANO_APPCHAIN_INDEXER_PATH=../data-preprod/appchain-indexers

# Both image flavors. An explicit -Xmx overrides the native default below.
# JAVA_OPTS=-Xms1g -Xmx4g
# Native image only. The entrypoint uses this when JAVA_OPTS has no -Xmx.
YANO_NATIVE_MAX_HEAP=1536m
YANO_EXTRA_ARGS=

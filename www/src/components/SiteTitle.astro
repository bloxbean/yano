---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a class="brand" href={siteTitleHref} aria-label="Yano home">
  <img src="/logo.svg" width="34" height="34" alt="" />
  <span class="wordmark" translate="no">
    yano
  </span>
  <span class="slash" aria-hidden="true">
    /
  </span>
  <span class="caption">BUILD ON CARDANO</span>
</a>

<style>
  .brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 10px;
    color: var(--sl-color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  img {
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .wordmark {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -2px;
  }

  .slash {
    padding-inline: 10px;
    color: var(--sl-color-gray-4);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 400;
    line-height: 1;
  }

  .caption {
    color: var(--sl-color-gray-3);
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 1.5px;
  }

  @media (max-width: 50rem) {
    .slash,
    .caption {
      display: none;
    }
  }
</style>

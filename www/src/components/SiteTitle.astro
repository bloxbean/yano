---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a class="brand" href={siteTitleHref} aria-label="Yano home">
  <svg class="mark" viewBox="4 0 96 96" width="34" height="34" aria-hidden="true">
    <polygon class="wing" points="79.25,14.11 11.45,46.01 37.37,55.98"></polygon>
    <polygon class="wing" points="85.89,20.75 53.99,88.55 44.02,62.63"></polygon>
    <polygon class="slash-mark" points="92.54,7.46 89.05,14.61 25.24,78.42 21.58,74.76 85.39,10.95"></polygon>
  </svg>
  <span class="wordmark" translate="no">
    yano
  </span>
  <span class="slash" aria-hidden="true">
    /
  </span>
  <span class="caption">BUILD ON CARDANO</span>
</a>

<style>
  .brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 10px;
    color: var(--sl-color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .mark {
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
  }

  .wing {
    fill: var(--yano-mark-wing);
  }

  .slash-mark {
    fill: var(--yano-mark-slash);
  }

  .wordmark {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -2px;
  }

  .slash {
    padding-inline: 10px;
    color: var(--sl-color-gray-4);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 400;
    line-height: 1;
  }

  .caption {
    color: var(--sl-color-gray-3);
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 1.5px;
  }

  @media (max-width: 50rem) {
    .slash,
    .caption {
      display: none;
    }
  }
</style>

---
import { Code } from 'astro:components';
import '../styles/landing.css';
const paths = [
  {
    id: 'node',
    number: '01',
    title: 'Read the chain.',
    label: 'Data node',
    text: 'Connect your favorite off-chain SDK in any language. Query Cardano state, evaluate scripts, and let Yano handle network submission.',
    href: '/node/networks/',
    cta: 'Explore the data node',
    file: 'terminal',
    lang: 'bash' as const,
    code: './yano.sh start:preprod\n\n# Query your local view of Cardano\ncurl http://localhost:7070/api/v1/node/tip\n\n# Read current protocol parameters\ncurl http://localhost:7070/api/v1/epochs/latest/parameters',
    stat: 'Cardano → local state → your application',
  },
  {
    id: 'test',
    number: '02',
    title: 'Make testing real.',
    label: 'Devnet & testkit',
    text: 'Give your tests a real, local Cardano chain. Fund wallets, control time, and return to a known snapshot whenever you need.',
    href: '/develop/java-testkit/',
    cta: 'Meet the testkit',
    file: 'MyDevnetTest.java',
    lang: 'java' as const,
    code: '@RegisterExtension\nstatic YanoDevnetExtension yano = YanoDevnetExtension\n    .devnet().startNode().blockTimeMillis(200);\n\n@Test\nvoid fundsWallet(YanoDevnetTestKit kit) {\n    var wallet = kit.wallets().newWallet();\n    kit.faucet().fund(wallet.address(), 10_000_000L);\n    kit.time().advanceSlots(1);\n    kit.assertions().wallet(wallet).hasAtLeast(10_000_000L);\n}',
    stat: 'Arrange → produce blocks → assert',
  },
  {
    id: 'app',
    number: '03',
    title: 'Build your own chain.',
    label: 'App chains',
    text: 'Start with the JVM release and turn application events into a shared, verifiable history. Begin with an ordered log, then extend the rules.',
    href: '/app-chains/quickstart/',
    cta: 'Create an app chain',
    file: 'terminal',
    lang: 'bash' as const,
    code: './yano.sh start:devnet,appchain\n\n# Submit an event to the built-in ordered log\ncurl -X POST \\\n  localhost:7070/api/v1/app-chain/chains/orders-chain/messages \\\n  -H \'Content-Type: application/json\' \\\n  -d \'{"topic":"order-created","body":"order A-1001"}\'',
    stat: 'Submit → finalize → prove → optionally anchor',
  },
];
const features = [
  [
    '01',
    'Your SDK. Your language.',
    'Keep your favorite off-chain SDK. Query chain data, evaluate scripts, and submit transactions through a Blockfrost-compatible API.',
    '/develop/blockfrost/',
    'Connect your SDK',
  ],
  [
    '02',
    'A chain inside your tests',
    'Real blocks and RocksDB state. Java, JUnit, JavaScript, and TypeScript workflows.',
    '/develop/javascript-testkit/',
    'Testing tools',
  ],
  [
    '03',
    'Time on your terms',
    'Advance slots, cross epochs, trigger rollbacks, and restore a known starting point.',
    '/develop/time-travel/',
    'Devnet controls',
  ],
  [
    '04',
    'Proofs you can inspect',
    'Member-certified app blocks, state commitments, inclusion proofs, and optional L1 anchors.',
    '/app-chains/proofs/',
    'Proofs & finality',
  ],
  [
    '05',
    'Room for your own rules',
    'Embed the node in Java or extend the JVM host through public plugin contracts.',
    '/develop/embed/',
    'Embed & extend',
  ],
  [
    '06',
    'See what is happening',
    'An embedded console, health endpoints, metrics, and optional historical data projection.',
    '/operate/console/',
    'Operate your node',
  ],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Yano is a Cardano data node in Java. Query the chain, run real devnet tests, and build verifiable app chains with one modular foundation."
    />
    <meta name="theme-color" content="#0b100d" />
    <link rel="canonical" href="https://getyano.dev/" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI documentation index" />
    <meta property="og:title" content="Yano — Your foundation for building on Cardano" />
    <meta
      property="og:description"
      content="A data node. A real devnet. Your app chain. Explore Yano."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://getyano.dev/" />
    <meta property="og:image" content="https://getyano.dev/social.svg" />
    <title>Yano — Your foundation for building on Cardano</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Yano home">
        <img src="/logo.svg" width="34" height="34" alt="" />
        yano<span class="brand-slash">/</span>
        <span class="brand-caption">BUILD ON CARDANO</span>
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav">
        Menu <span aria-hidden="true">＋</span>
      </button>
      <nav id="nav" aria-label="Main navigation">
        <a href="/start/overview/">Documentation</a>
        <a href="#possibilities">Explore</a>
        <a href="/ai/overview/">
          For AI{' '}
          <span class="spark" aria-hidden="true">
            ✧
          </span>
        </a>
        <a class="github" href="https://github.com/bloxbean/yano">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap">
        <div class="hero-copy">
          <a href="/operate/upgrades/" class="release">
            <span class="status-dot"></span> OPEN SOURCE <span aria-hidden="true">↗</span>
          </a>
          <h1>
            Your foundation
            <br />
            for building
            <br />
            on <span>Cardano.</span>
          </h1>
          <p class="hero-description">
            A data node. A real devnet. Your app chain.
            <br />
            Build your dApp in any language, with your favorite SDK. Query, evaluate, and submit
            transactions through Yano’s Blockfrost-compatible API.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="/start/quickstart/">
              Start building <span aria-hidden="true">↗</span>
            </a>
            <a class="button secondary" href="/start/overview/">
              Discover Yano <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="hero-footnote">
            <span>JAVA 25</span>
            <i></i>
            <span>JVM + NATIVE</span>
            <i></i>
            <span>MIT LICENSE</span>
          </div>
        </div>
        <div
          class="system-visual"
          role="img"
          aria-label="Yano connects Cardano ledger data to applications, devnet tests, and app chains with proofs."
        >
          <div class="visual-top">
            <span class="tiny-label">ONE FOUNDATION. MANY POSSIBILITIES.</span>
            <span class="visual-symbol">⌘</span>
          </div>
          <div class="orbit-scene" aria-hidden="true">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="orbit orbit-three"></div>
            <div class="orbit-spinner">
              <span></span>
            </div>
            <div class="cross horizontal"></div>
            <div class="cross vertical"></div>
            <div class="core-glow"></div>
            <div class="core">
              <img src="/logo.svg" alt="" width="48" height="48" />
              <strong>yano</strong>
              <span>BUILDING BLOCK</span>
            </div>
            <div class="satellite satellite-data">
              <span class="satellite-icon">▤</span>
              <div>
                <small>READ & QUERY</small>
                <strong>Data node</strong>
              </div>
              <span class="node-light"></span>
            </div>
            <div class="satellite satellite-test">
              <span class="satellite-icon">⌁</span>
              <div>
                <small>CREATE & TEST</small>
                <strong>Local devnet</strong>
              </div>
              <span class="node-light"></span>
            </div>
            <div class="satellite satellite-app">
              <span class="satellite-icon">◇</span>
              <div>
                <small>ORDER & PROVE</small>
                <strong>App chains</strong>
              </div>
              <span class="node-light"></span>
            </div>
            <div class="chain-label">
              CARDANO L1 <span>↗</span>
            </div>
            <span class="coordinate coord-a">01 / DATA</span>
            <span class="coordinate coord-b">02 / STATE</span>
          </div>
          <div class="visual-bottom">
            <span>
              <span class="status-dot"></span> MODULAR BY DESIGN
            </span>
            <span>org.yanoproject</span>
          </div>
        </div>
      </section>
      <div class="foundation-bar">
        <div class="wrap">
          <span>
            FAMILIAR TOOLS.
            <br />
            <strong>NEW POSSIBILITIES.</strong>
          </span>
          <p>
            Cardano <span>↗</span>
          </p>
          <p>
            Java <span>↗</span>
          </p>
          <p>
            RocksDB <span>↗</span>
          </p>
          <p>
            GraalVM <span>↗</span>
          </p>
          <p>
            REST API <span>↗</span>
          </p>
        </div>
      </div>
      <section class="workflows wrap" id="possibilities">
        <div class="section-heading">
          <div>
            <p class="eyebrow">/ FIND YOUR STARTING POINT</p>
            <h2>
              One node.
              <br />
              <span>A whole lot you can do.</span>
            </h2>
          </div>
          <p>
            From your first local block to an application ledger.
            <br />
            Start small. Go as deep as you need.
          </p>
        </div>
        <div class="workflow-tabs" role="tablist" aria-label="Explore Yano capabilities">
          {paths.map((path, index) => (
            <button
              role="tab"
              id={`tab-${path.id}`}
              aria-controls={`panel-${path.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-tab={path.id}
            >
              <span>{path.number}</span>
              {path.label}
              <span class="tab-arrow" aria-hidden="true">
                ↗
              </span>
            </button>
          ))}
        </div>
        {paths.map((path, index) => (
          <div
            class="workflow-panel"
            id={`panel-${path.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${path.id}`}
            hidden={index !== 0}
            tabindex="0"
          >
            <div class="workflow-copy">
              <span class="tiny-label">{path.label.toUpperCase()}</span>
              <h3>{path.title}</h3>
              <p>{path.text}</p>
              <a class="text-link" href={path.href}>
                {path.cta}
                <span aria-hidden="true">→</span>
              </a>
              <p class="flow-caption">{path.stat}</p>
            </div>
            <div class="code-window">
              <div class="code-title">
                <span>
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
                <span>{path.file}</span>
                <button
                  class="copy-code"
                  data-code={path.code}
                  aria-label={`Copy ${path.label} example`}
                >
                  Copy
                </button>
              </div>
              <Code code={path.code} lang={path.lang} theme="github-dark" />
              <div class="code-note">
                {path.id === 'test'
                  ? 'Excerpt · full imports and setup in the guide'
                  : 'Run from an extracted release directory'}
              </div>
            </div>
          </div>
        ))}
      </section>
      <section class="capabilities wrap">
        <div class="section-heading">
          <div>
            <p class="eyebrow">/ THE BUILDING BLOCKS</p>
            <h2>
              Powerful underneath.
              <br />
              <span>Approachable by design.</span>
            </h2>
          </div>
          <a class="text-link" href="/start/overview/">
            Explore the documentation <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="feature-grid">
          {features.map(([number, title, text, href, cta]) => (
            <a class="feature" href={href}>
              <div class="feature-top">
                <span class="feature-number">{number}</span>
                <span aria-hidden="true">↗</span>
              </div>
              <h3>{title}</h3>
              <p>{text}</p>
              <span class="feature-link">{cta}</span>
            </a>
          ))}
        </div>
      </section>
      <section class="ai-section wrap">
        <div class="ai-art" aria-hidden="true">
          <span>✧</span>
          <div>CONTEXT, READY.</div>
          <code>llms.txt</code>
        </div>
        <div class="ai-copy">
          <p class="eyebrow">/ BUILT FOR HOW YOU BUILD</p>
          <h2>
            Your next collaborator
            <br />
            <span>can read these docs, too.</span>
          </h2>
          <p>
            Give your coding assistant accurate Yano context. Plain Markdown, configuration data,
            and versioned artifacts — ready for your workflow.
          </p>
          <div>
            <a class="button primary" href="/ai/overview/">
              Build with AI <span aria-hidden="true">✧</span>
            </a>
            <a class="text-link" href="/llms.txt">
              Open llms.txt <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
      <section class="closing wrap">
        <p class="eyebrow">/ YOUR FIRST BLOCK STARTS HERE</p>
        <h2>
          Less setup.
          <br />
          <span>More building.</span>
        </h2>
        <a class="button primary" href="/start/quickstart/">
          Start your local node <span aria-hidden="true">↗</span>
        </a>
        <p>
          Pre-release software. Explore, test, and prototype.
          <br />
          See the docs for feature status and operational boundaries.
        </p>
      </section>
    </main>
    <footer class="wrap">
      <div>
        <a class="brand" href="/">
          <img src="/logo.svg" alt="" width="30" height="30" />
          yano
        </a>
        <p>
          A Cardano data node, in Java.
          <br />
          Open source. Open possibilities.
        </p>
      </div>
      <div class="footer-links">
        <div>
          <strong>BUILD</strong>
          <a href="/start/quickstart/">Get started</a>
          <a href="/develop/java-testkit/">Testkit</a>
          <a href="/app-chains/overview/">App chains</a>
        </div>
        <div>
          <strong>EXPLORE</strong>
          <a href="/reference/configuration/">Configuration</a>
          <a href="/reference/http-api/">API reference</a>
          <a href="/ai/overview/">AI resources</a>
        </div>
        <div>
          <strong>PROJECT</strong>
          <a href="https://github.com/bloxbean/yano">GitHub ↗</a>
          <a href="/contribute/guide/">Contribute</a>
          <a href="https://github.com/bloxbean/yano-x">Yano X ↗</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>Yano · MIT licensed</span>
        <span>Made for builders on Cardano.</span>
        <a href="#main">Back to top ↑</a>
      </div>
    </footer>
    <div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>
    <script>
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
      function selectTab(tab: HTMLButtonElement, focus = false) {
        tabs.forEach((item) => {
          const selected = item === tab;
          item.setAttribute('aria-selected', String(selected));
          item.tabIndex = selected ? 0 : -1;
          const panel = document.getElementById(`panel-${item.dataset.tab}`);
          if (panel) panel.hidden = !selected;
        });
        if (focus) tab.focus();
      }
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
          let next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault();
          selectTab(tabs[next], true);
        });
      });
      document.querySelectorAll<HTMLButtonElement>('.copy-code').forEach((button) =>
        button.addEventListener('click', async () => {
          const status = document.getElementById('copy-status');
          try {
            await navigator.clipboard.writeText(button.dataset.code || '');
            button.textContent = 'Copied';
            if (status) status.textContent = 'Example copied to clipboard';
          } catch {
            if (status) status.textContent = 'Could not copy. Select and copy the code manually.';
            button.textContent = 'Select code';
          }
          window.setTimeout(() => (button.textContent = 'Copy'), 2000);
        }),
      );
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.getElementById('nav');
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('is-open', open);
      });
      nav?.querySelectorAll('a').forEach((link) =>
        link.addEventListener('click', () => {
          menu?.setAttribute('aria-expanded', 'false');
          nav.classList.remove('is-open');
        }),
      );
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') {
          menu.setAttribute('aria-expanded', 'false');
          nav?.classList.remove('is-open');
          menu.focus();
        }
      });
    </script>
  </body>
</html>

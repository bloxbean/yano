# ADR-060: the corpora of the Cardano node-diversity reports, pinned. fetch-corpora.sh reads
# this file. Changing a pin is a deliberate corpus upgrade: regenerate the reports and compare the scores.

# https://github.com/pragma-org/node-diversity-conformance (ledger-rules fixtures)
NDC_REPOSITORY=https://github.com/pragma-org/node-diversity-conformance.git
NDC_REVISION=9dc68a750478335755d057288cc8978c117d7ac4
# The ledger-rules report's dataset_commit: the pragma-org/amaru commit that last changed
# crates/amaru-ledger/tests/data/transaction/scenarios, the source of the fixtures at NDC_REVISION
NDC_LEDGER_RULES_DATASET_COMMIT=40ba995081b2b066cab497eade9abfbc0e350970
# Workaround: the fixtures at NDC_REVISION name three protocol-parameter files the repository does not
# have. fetch-corpora.sh adds them from Amaru at NDC_LEDGER_RULES_DATASET_COMMIT, where the fixtures come
# from, checked by sha256, and fails once NDC has them, so that this is removed. <file>:<sha256> pairs.
AMARU_RAW=https://raw.githubusercontent.com/pragma-org/amaru
LEDGER_RULES_MISSING_PARAMETERS="\
preprod-conway-v9-zero-cost-models.json:c90a092471d571dfa3f1b5688b100aafe7616f296b841c9a3c8df14c8b75ec1f \
preprod-conway-v10-zero-cost-models.json:b7939a6ed1681c77ae11bb3e1451bea8699145c0074f89d9ce86ae912a83dc81 \
preprod-conway-v10-no-v3-cost-models.json:1bd993bac8ac2c9163bebccffd4343b372d2800fdf1986fa0654ce7e4cdcd59c"

# https://github.com/r2rationality/cardano-cbor-dataset
CBOR_DATASET_REPOSITORY=https://github.com/r2rationality/cardano-cbor-dataset.git
CBOR_DATASET_REVISION=4fd977b201f7426a2983161a702bb127c87973f7

# The two UPLC tarballs the scenario pages link to
UPLC_CORPUS_URL=https://pub-2239d82d9a074482b2eb2c886191cb4e.r2.dev/uplc-conformance.tar.zst
UPLC_CORPUS_SHA256=8bd4ad4f9f4c8c6b8ffa1f06ed1db0b43043afbba77ef6a14bcfb5a52345ed3f
TURBO_CORPUS_URL=https://pub-2239d82d9a074482b2eb2c886191cb4e.r2.dev/turbo.tar.zst
TURBO_CORPUS_SHA256=821af55e3323c826b5598c964d634b46dd468014834d0e97ebdc5edb0a158576

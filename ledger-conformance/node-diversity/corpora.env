# The pinned conformance corpora: those of the Cardano node-diversity reports (ADR-060) and the Amaru
# transaction scenarios of the ledger-conformance harness (ADR-062 D5). fetch-corpora.sh and
# ledger-conformance/build.gradle read this file. Changing a pin is a deliberate corpus upgrade: rerun the
# conformance, regenerate the reports and compare.

# https://github.com/pragma-org/amaru (crates/amaru-ledger/tests/data/transaction: the scenarios)
AMARU_REPOSITORY=https://github.com/pragma-org/amaru.git
AMARU_TAG=v10.11.20261105
AMARU_REVISION=c773f8486e5b64284506824daa3974020e0c8bf6

# https://github.com/pragma-org/node-diversity-conformance (ledger-rules fixtures)
NDC_REPOSITORY=https://github.com/pragma-org/node-diversity-conformance.git
NDC_REVISION=00be740c31dae56bf63acd4c3d10767c1e4d3c6c

# https://github.com/r2rationality/cardano-cbor-dataset
CBOR_DATASET_REPOSITORY=https://github.com/r2rationality/cardano-cbor-dataset.git
CBOR_DATASET_REVISION=95e9e7c296ca1b641c8d99af2ab7c286a90caebf

# The two UPLC tarballs the scenario pages link to
UPLC_CORPUS_URL=https://pub-2239d82d9a074482b2eb2c886191cb4e.r2.dev/uplc-conformance.tar.zst
UPLC_CORPUS_SHA256=8bd4ad4f9f4c8c6b8ffa1f06ed1db0b43043afbba77ef6a14bcfb5a52345ed3f

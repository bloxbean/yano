; =============================================================================
; Yano App-Chain: L1 observation wire format (v1) — ADR app-layer/028 M1
; =============================================================================
; Body of a `~l1/<observer-id>` message: a tagged pointer plus a canonical
; observer-specific claim. Transaction observers use tag 0. Epoch observers
; use tag 1 and identify the first applied block of the new epoch. The former
; preview form with tx-hash directly in field 2 is not part of this grammar.

l1-observation = [
    version     : 1,
    observer-id : tstr .size (1..128),
    anchor      : transaction-anchor / epoch-anchor,
    slot        : uint,
    block-hash  : bstr .size 32,
    claim       : bstr,
]

transaction-anchor = [
    tag     : 0,
    tx-hash : bstr .size 32,
]

epoch-anchor = [
    tag       : 1,
    new-epoch : uint,
]

; Built-in transaction claim payloads:
;
; metadata-label observer:
;   claim = the raw CBOR bytes of the watched label's metadata value
;
; address-deposit observer:
;   claim = [ address : tstr, lovelace : uint ]
;
; Epoch observer claim schemas are independently versioned by ADR-028.

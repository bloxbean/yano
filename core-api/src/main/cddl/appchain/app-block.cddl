; =============================================================================
; Yano App-Chain: App Block and Finality Certificate (v3)
; =============================================================================
; One finalized app-chain block: a batch of verified app messages given a
; total order by the sequencer, binding the post-state commitment root.
; Canonical CBOR — the same complete block bytes are gossiped (proposals on
; system topic "~consensus/propose") and stored in the app ledger. Prepare and
; commit votes sign domain-separated digests over the block hash.
;
; block-hash = blake2b-256( cbor(app-block-header) )
;   The header binds the ordered message ids via messages-root and the committed
;   history via prev-hash. It does not bind every app-message envelope field or
;   the certificate container; it binds proposer and the justification digest.
;
; messages-root: binary merkle tree (blake2b-256 over left||right) built over
;   the ordered message-ids; empty list -> 32 zero bytes; odd level width ->
;   last node duplicated.
;
; state-root: Merkle Patricia Forestry root (Aiken-compatible, blake2b-256)
;   AFTER applying this block — followers validate the authenticated proposal
;   and messages, re-execute them, and must reproduce the committed header
;   fields before voting.
;
; Consensus messages ride the ordinary authenticated app-message envelope
; (see app-message-envelope.cddl) on reserved system topics:
;   "~consensus/propose" body = app-block (cert empty)
;   "~consensus/prepare" body = certified-vote
;   "~consensus/prepared" body = quorum-certificate
;   "~consensus/commit" body = certified-vote
;   "~consensus/timeout" body = timeout
;   "~consensus/new-view" body = new-view-certificate
;   "~consensus/cert"    body = cert-notice
; =============================================================================

app-block = [
    version       : 3,                ; certified-consensus fresh-chain format
    chain-id      : tstr .size (1..128), ; valid UTF-8, byte length bound
    height        : uint,             ; global per-chain sequence, first block = 1
    consensus-context-digest : bstr .size 32,
    view          : uint,
    prev-hash     : bstr .size 32,    ; 32 zero bytes at height 1
    l1-slot       : uint,             ; stable L1 reference slot (0 = unavailable)
    l1-block-hash : (bstr .size 0) / (bstr .size 32), ; empty = unavailable
    timestamp     : uint,             ; proposer wall clock, unix millis
    messages-root : bstr .size 32,
    state-root    : bstr .size 32,
    messages      : [ *10000 app-message ], ; ordered full envelopes
    proposer      : bstr .size 32,    ; proposal identity, committed by block-hash
    justification : bstr,             ; empty in view 0, canonical new-view cert otherwise
    cert          : finality-cert
]

app-block-header = [
    version, chain-id, height, consensus-context-digest, view,
    prev-hash, l1-slot, l1-block-hash,
    timestamp, messages-root, state-root, proposer, justification-digest
]

finality-cert = [
    scheme     : uint,                ; 0 = Ed25519 signatures over commit digest
    signatures : [ *32 cert-signature ] ; empty only while proposed; finalized >= 1
]

cert-signature = [
    signer    : bstr .size 32,        ; member Ed25519 public key
    signature : bstr .size 64
]

cert-notice = [
    height     : uint,
    block-hash : bstr .size 32,
    cert       : bstr                 ; cbor(finality-cert)
]

; app-message: see yaci core/src/main/cddl/appmsg/app-message-envelope.cddl
